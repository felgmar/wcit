<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>..\ConsoleApp\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowsInstaller.ico</ApplicationIcon>
    <Version Condition="'$(WindowsInstallerUIVersion)' == ''">1.0.0</Version>
    <Version Condition="'$(WindowsInstallerUIVersion)' != ''">$(WindowsInstallerUIVersion)</Version>
    <Company>felgmar</Company>
    <Authors>Felipe González Martín</Authors>
    <Product>Windows Installer</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WindowsInstaller.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WindowsInstaller.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsInstallerLib\WindowsInstallerLib.csproj" />
  </ItemGroup>

</Project>
